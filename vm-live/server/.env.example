# Kopiera till .env och fyll i. Servern kör på mock-data om inget anges.

# Datakälla: mock | api-football | football-data
MATCH_PROVIDER=mock

# API-Football (api-sports.io) – förstaval, VM = league 1 / season 2026
API_FOOTBALL_KEY=

# football-data.org – gratis fallback, VM = competition-kod WC
FOOTBALL_DATA_TOKEN=

# Server
PORT=4000
LIVE_POLL_MS=15000
IDLE_POLL_MS=60000
